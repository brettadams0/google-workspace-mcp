{
  "name": "google-workspace-mcp",
  "version": "2.0.0",
  "type": "module",
  "description": "MCP server giving Claude Code write access to Gmail, Calendar, Drive, Sheets and YouTube via a self-owned Google OAuth client",
  "main": "src/index.js",
  "scripts": {
    "authorize": "node scripts/authorize.js",
    "check-auth": "node scripts/check-token.js",
    "smoke-test": "node scripts/smoke-test.js",
    "test": "node --test test/tools.test.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "surface": "mcp-surface node src/index.js --snapshot mcp-surface.json --fail-on warn",
    "surface:update": "mcp-surface node src/index.js --snapshot mcp-surface.json --update-snapshot"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/drive": "^26.0.2",
    "@googleapis/gmail": "^22.0.2",
    "@googleapis/sheets": "^18.1.1",
    "@googleapis/youtube": "^40.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "google-auth-library": "^11.3.1",
    "zod": "^3.25.76"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "google-api",
    "gmail",
    "google-calendar",
    "google-drive",
    "google-sheets",
    "youtube",
    "oauth2"
  ],
  "license": "MIT",
  "author": "Brett Adams",
  "bin": {
    "google-workspace-mcp": "src/index.js"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettadams0/google-workspace-mcp.git"
  },
  "homepage": "https://github.com/brettadams0/google-workspace-mcp#readme",
  "bugs": {
    "url": "https://github.com/brettadams0/google-workspace-mcp/issues"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mcp-surface": "^0.3.0"
  }
}
