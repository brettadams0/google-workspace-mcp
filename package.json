{
  "name": "google-workspace-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server giving Claude Code write access to Gmail, Calendar, Drive, Sheets and YouTube via a self-owned Google OAuth client",
  "main": "src/index.js",
  "scripts": {
    "authorize": "node scripts/authorize.js",
    "check-auth": "node scripts/check-token.js",
    "smoke-test": "node scripts/smoke-test.js",
    "test": "node --test test/tools.test.js",
    "start": "node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "googleapis": "^173.0.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "gaxios": "^7.3.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "google-api",
    "gmail",
    "google-calendar",
    "google-drive",
    "google-sheets",
    "youtube",
    "oauth2"
  ],
  "license": "MIT",
  "author": "Brett Adams",
  "bin": {
    "google-workspace-mcp": "src/index.js"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettadams0/google-workspace-mcp.git"
  },
  "homepage": "https://github.com/brettadams0/google-workspace-mcp#readme",
  "bugs": {
    "url": "https://github.com/brettadams0/google-workspace-mcp/issues"
  },
  "private": true
}
